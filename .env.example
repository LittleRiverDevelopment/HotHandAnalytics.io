# The Odds API key the three boards use without the admin password.
# Get a free key at: https://the-odds-api.com/
# NEXT_PUBLIC_ exposes it to the browser, same as HotHand.
NEXT_PUBLIC_ODDS_API_KEY=your_api_key_here

# Backup key. Compiled like the primary key, but LineSnipe does not send it
# until the admin password is entered in this browser tab.
NEXT_PUBLIC_ODDS_API_KEY_2=your_second_api_key_here

# Password for the in-app Admin screen. Convenience guard, not real authentication.
# Compiled into the static site. Add the same value as a GitHub Actions secret before deploying.
NEXT_PUBLIC_ADMIN_PASSWORD=choose_an_admin_password
